# ==============================================================================
# Prefetch Configuration (Evaluated for *-prefetch kernels)
# ==============================================================================
# 1. Prefetch distances (Lookahead distance: 0=No prefetch, 1..64 cache lines)
# Format: [Promotion:Demotion] or p<prom>_d<dem> or single value (e.g. 4 is equivalent to 4:4)
# Supports composite tags: e.g. p1_d4_min1_max12
# When commented out: uses kernel default lookahead distance
PREFETCH_DISTANCES=(
    # Paired Promotion:Demotion Testing
    p5_d2
)

# 2. Prefetch distance clamp limits (min_dist : max_dist)
# Evaluated for *-prefetch kernels: clamp(dist, min, max)
# Format: [Min:Max] or min<min>_max<max> or max value (default min=1)
# Default if commented out: min=1, max=10
PREFETCH_BOUNDS=(
    min1_max12
)

# 3. Prefetch distance adaptation mode (Evaluated for *-prefetch kernels)
# 0 = Static / Non-adaptive distance (fixed lookahead distance)
# 1 = Adaptive distance enabled (scales distance dynamically based on Little's Law)
# Uncomment / comment to select which condition(s) to evaluate:
PREFETCH_ADAPTIVE_MODES=(
    0    # Non-adaptive (Static)
    1    # Adaptive
)

# ==============================================================================
# Transparent Huge Pages (THP) Configuration
# Evaluated for both prefetch and non-prefetch kernels
# ==============================================================================
# Supported THP modes:
#   always  (1 / on)  : echo always | sudo tee /sys/kernel/mm/transparent_hugepage/enabled
#   madvise (0 / off) : echo madvise | sudo tee /sys/kernel/mm/transparent_hugepage/enabled
#   never             : echo never | sudo tee /sys/kernel/mm/transparent_hugepage/enabled
# Uncomment / comment to select which THP mode(s) to evaluate:
THP_MODES=(
    always
    madvise
)

