+#define PREFETCH_WAVE1_LOOP(addr, dist, locality) do {			\
+	unsigned int __i;						\
+	for (__i = 0; __i < (dist); __i++) {				\
+		unsigned int __line = (__i < 4) ? __i : (4 + (__i - 4) * 2); \
+		if (__line >= (PAGE_SIZE / SMP_CACHE_BYTES))		\
+			break;						\
+		__builtin_prefetch((addr) + (__line * SMP_CACHE_BYTES),	\
+				   0, (locality));			\
+	}								\
+} while (0)
+
+#define PREFETCH_WAVE2_LOOP(src_addr, start_line, dist, locality) do {	\
+	unsigned int __i;						\
+	for (__i = 0; __i < (dist); __i++) {				\
+		unsigned int __line = (start_line) + __i * 2;		\
+		if (__line >= (PAGE_SIZE / SMP_CACHE_BYTES))		\
+			break;						\
+		__builtin_prefetch((src_addr) + (__line * SMP_CACHE_BYTES), \
+				   0, (locality));			\
+	}								\
+} while (0)
+
+#define PREFETCH_CONT_LOOP(addr, dist, locality) do {			\
+	unsigned int __i;						\
+	for (__i = 0; __i < (dist); __i++) {				\
+		if (__i >= (PAGE_SIZE / SMP_CACHE_BYTES))		\
+			break;						\
+		__builtin_prefetch((addr) + (__i * SMP_CACHE_BYTES),	\
+				   0, (locality));			\
+	}								\
+} while (0)
+
+#define PREFETCH_DISPATCH_HINT(loop_macro, ...) do {			\
+	if (static_branch_likely(&prefetch_hint_nta))			\
+		loop_macro(__VA_ARGS__, 0);				\
+	else if (static_branch_unlikely(&prefetch_hint_l2))		\
+		loop_macro(__VA_ARGS__, 2);				\
+	else if (static_branch_unlikely(&prefetch_hint_l3))		\
+		loop_macro(__VA_ARGS__, 1);				\
+	else								\
+		loop_macro(__VA_ARGS__, 3);				\
+} while (0)
+
+/*
+ * Wave 1 (Lead-time prefetch):
+ * Uses 2-cacheline spatial stride (i * 2) when d >= 4 so the CPU's L2
+ * Spatial / Adjacent-Cache-Line prefetcher pulls the odd companion lines.
+ * Hint selection uses static_branch jump labels (zero hot-path loads/branches).
+ */
+static inline void prefetch_page_wave1(struct page *page, unsigned int dist)
+{
+	const char *addr;
+
+	if (!dist || PageHighMem(page))
+		return;
+
+	addr = page_address(page);
+	PREFETCH_DISPATCH_HINT(PREFETCH_WAVE1_LOOP, addr, dist);
+}
+
+/*
+ * Wave 2 (Mid-page pipeline prefetch):
+ */
+static inline void prefetch_page_wave2(const char *src_addr, unsigned int dist)
+{
+	unsigned int start_line;
+
+	if (!dist)
+		return;
+
+	start_line = (dist <= 4) ? dist : (4 + (dist - 4) * 2);
+	PREFETCH_DISPATCH_HINT(PREFETCH_WAVE2_LOOP, src_addr, start_line, dist);
+}
+
+static inline void prefetch_page_continuous(struct page *page, unsigned int dist)
+{
+	const char *addr;
+
+	if (!dist || PageHighMem(page))
+		return;
+
+	addr = page_address(page);
+	PREFETCH_DISPATCH_HINT(PREFETCH_CONT_LOOP, addr, dist);
+}
+
+static inline void prefetch_folio_head(struct folio *folio)
+{
+	unsigned int dist;
+
+	if (!static_branch_likely(&prefetch_enabled_key))
+		return;
+	dist = get_migration_prefetch_distance(folio_nid(folio));
+	if (!dist)
+		return;
+	if (static_branch_unlikely(&prefetch_naive_key))
+		prefetch_page_continuous(folio_page(folio, 0), dist);
+	else
+		prefetch_page_wave1(folio_page(folio, 0), dist);
+}
+
+/*
+ * Naive Cacheline Prefetch:
+ * Structured similar to folio_copy_adaptive, but without Wave 2 mid-page prefetch,
+ * and uses continuous prefetching instead of 2-cacheline spatial stride.
+ */
+static void folio_copy_naive(struct folio *dst, struct folio *src,
+			     unsigned int distance)
+{
+	long nr = folio_nr_pages(src);
+	long i;
+
+	if (nr == 1) {
+		/*
+		 * 4KB Base Folio:
+		 * Head was prefetched continuously by prefetch_folio_head().
+		 * No Wave 2 prefetch. Directly copy.
+		 */
+		char *dst_k = kmap_local_folio(dst, 0);
+		char *src_k = kmap_local_folio(src, 0);
+
+		copy_page(dst_k, src_k);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+		return;
+	}
+
+	/* Multi-page folio (e.g., 2MB THP): prefetch next subpage [i + 1] continuously */
+	for (i = 0; i < nr; i++) {
+		struct page *src_p = folio_page(src, i);
+		struct page *dst_p = folio_page(dst, i);
+
+		char *dst_k = kmap_local_page(dst_p);
+		char *src_k = kmap_local_page(src_p);
+
+		/* Prefetch next subpage [i + 1] continuously (no Wave 2) */
+		if (i + 1 < nr)
+			prefetch_page_continuous(folio_page(src, i + 1), distance);
+
+		copy_page(dst_k, src_k);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+
+		if ((i & 0x1F) == 0x1F && (i + 1 < nr))
+			cond_resched();
+	}
+}
+
+/*
+ * Two-Wave Pipelined ERMS Folio Copy (Works for BOTH 4KB nr==1 and 2MB THP nr==512!):
+ */
+static void folio_copy_adaptive(struct folio *dst, struct folio *src,
+				unsigned int distance)
+{
+	long nr = folio_nr_pages(src);
+	long i;
+
+	if (nr == 1) {
+		/*
+		 * 4KB Base Folio:
+		 * Wave 1 already warmed the head of @src during unmap/TLB-flush
+		 * (or previous folio's PTE cleanup). Now fire Wave 2 for the
+		 * second part of @src right before native ERMS copy_page()!
+		 */
+		char *dst_k = kmap_local_folio(dst, 0);
+		char *src_k = kmap_local_folio(src, 0);
+
+		prefetch_page_wave2(src_k, distance);
+		copy_page(dst_k, src_k);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+		return;
+	}
+
+	/* Multi-page folio (e.g., 2MB THP): overlap Wave 2 of [i] & Wave 1 of [i+1] */
+	for (i = 0; i < nr; i++) {
+		struct page *src_p = folio_page(src, i);
+		struct page *dst_p = folio_page(dst, i);
+
+		char *dst_k = kmap_local_page(dst_p);
+		char *src_k = kmap_local_page(src_p);
+
+		/* Wave 2 for current subpage [i] (if d is small, split budget with [i+1]) */
+		prefetch_page_wave2(src_k, distance);
+
+		/* Wave 1 for next subpage [i + 1] */
+		if (i + 1 < nr)
+			prefetch_page_wave1(folio_page(src, i + 1), distance);
+
+		copy_page(dst_k, src_k);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+
+		if ((i & 0x1F) == 0x1F && (i + 1 < nr))
+			cond_resched();
+	}
+}
