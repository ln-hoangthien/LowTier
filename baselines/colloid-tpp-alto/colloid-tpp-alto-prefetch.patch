+/*
+ * Pipelined Cacheline Prefetching (Method 1: Cacheline-lookahead)
+ * Uses separate lookahead distances for promotion and demotion.
+ * Supports dynamic Little's Law adaptation:
+ *   adaptive=0: Static prefetch distance (promote_distance, demote_distance)
+ *   adaptive=1: Dynamic Little's Law adaptation:
+ *               Distance = TOR_OCCUPANCY / sum_cycles (MLP),
+ *               dynamically updated via promote_distance and demote_distance
+ *
+ * Promotion (remote slow tier -> local fast tier):
+ *   Uses promote_distance (def: 5)
+ * Demotion (local fast tier -> remote slow tier):
+ *   Uses demote_distance (def: 2)
+ *
+ * Configurable via sysfs (/sys/kernel/mm/page_prefetch/):
+ *   enabled:                  master toggle (0 or 1, default: 1)
+ *   naive:                    prefetch engine (0=deep-tune two-wave, 1=naive lookahead, default: 0)
+ *   adaptive:                 adaptation mode (0=static, 1=adaptive Little's Law, default: 1)
+ *   promote_distance:         lookahead distance for promotion (default: 5)
+ *   demote_distance:          lookahead distance for demotion (default: 2)
+ *   min_distance:             minimum clamp distance (default: 1)
+ *   max_distance:             maximum clamp distance (default: 16)
+ *   hint:                     cache hint (0=NTA, 1=L3, 2=L2, 3=L1, default: 0)
+ */
+#define PREFETCH_DEFAULT_PROMOTE_DISTANCE      5
+#define PREFETCH_DEFAULT_DEMOTE_DISTANCE       2
+#define PREFETCH_DEFAULT_MIN_DISTANCE          1
+#define PREFETCH_DEFAULT_MAX_DISTANCE          16
+#define PREFETCH_DEFAULT_HINT                  0
+
+#define MPOL_MF_PREFETCH_ENABLE                (1U << 15)
+#define MPOL_MF_PREFETCH_PROMOTE_SHIFT         16
+#define MPOL_MF_PREFETCH_PROMOTE_MASK          (0xFFU << MPOL_MF_PREFETCH_PROMOTE_SHIFT)
+#define MPOL_MF_PREFETCH_DEMOTE_SHIFT          24
+#define MPOL_MF_PREFETCH_DEMOTE_MASK           (0xFFU << MPOL_MF_PREFETCH_DEMOTE_SHIFT)
+#define MPOL_MF_PREFETCH_FLAGS                 (MPOL_MF_PREFETCH_ENABLE | \
+                                                MPOL_MF_PREFETCH_PROMOTE_MASK | \
+                                                MPOL_MF_PREFETCH_DEMOTE_MASK)
+
+static DEFINE_STATIC_KEY_TRUE(prefetch_enabled_key);
+static DEFINE_STATIC_KEY_FALSE(prefetch_naive_key);
+static DEFINE_STATIC_KEY_TRUE(prefetch_hint_nta);
+static DEFINE_STATIC_KEY_FALSE(prefetch_hint_l3);
+static DEFINE_STATIC_KEY_FALSE(prefetch_hint_l2);
+#ifdef CONFIG_SYSFS
+static unsigned int prefetch_enabled = 1;
+static unsigned int prefetch_naive = 0;
+static unsigned int prefetch_adaptive = 1;
+static unsigned int prefetch_min_distance = PREFETCH_DEFAULT_MIN_DISTANCE;
+static unsigned int prefetch_max_distance = PREFETCH_DEFAULT_MAX_DISTANCE;
+static unsigned int prefetch_hint = PREFETCH_DEFAULT_HINT;
+static DEFINE_MUTEX(prefetch_cfg_lock);
+#endif
+
+union pact_distances {
+	struct {
+		u16 promote;
+		u16 demote;
+	};
+	u32 val;
+};
+
+static union pact_distances prefetch_distances ____cacheline_aligned = {
+	.promote = PREFETCH_DEFAULT_PROMOTE_DISTANCE,
+	.demote  = PREFETCH_DEFAULT_DEMOTE_DISTANCE,
+};
+
+void page_prefetch_set_tier_distances(int promote_dist, int demote_dist)
+{
+	union pact_distances cur, next;
+	u32 old;
+
+	cur.val = READ_ONCE(prefetch_distances.val);
+	do {
+		next.promote = (promote_dist >= 0 && promote_dist <= 64) ?
+			       (u16)promote_dist : cur.promote;
+		next.demote  = (demote_dist >= 0 && demote_dist <= 64) ?
+			       (u16)demote_dist : cur.demote;
+		if (cur.val == next.val)
+			break;
+		old = cmpxchg(&prefetch_distances.val, cur.val, next.val);
+		if (old == cur.val)
+			break;
+		cur.val = old;
+	} while (1);
+}
+EXPORT_SYMBOL(page_prefetch_set_tier_distances);
+
+static inline bool is_tiered_promotion(int source_id)
+{
+	if (source_id < 0)
+		return false;
+	if (!node_is_toptier(source_id))
+		return true;
+	if (num_node_state(N_MEMORY) == num_node_state(N_CPU) && source_id > 0)
+		return true;
+	return false;
+}
+
+static inline bool is_tiered_promotion_dir(int src_id, int dst_id)
+{
+	if (src_id < 0 || dst_id < 0 || src_id == dst_id)
+		return false;
+	if (!node_is_toptier(src_id) && node_is_toptier(dst_id))
+		return true;
+	if (node_is_toptier(src_id) && !node_is_toptier(dst_id))
+		return false;
+	return src_id > dst_id;
+}
+
+static inline unsigned int get_migration_prefetch_distance(int source_id)
+{
+	union pact_distances d = { .val = READ_ONCE(prefetch_distances.val) };
+
+	return is_tiered_promotion(source_id) ? d.promote : d.demote;
+}
+
+static inline unsigned int get_migration_prefetch_distance_dir(int src_id,
+							       int dst_id)
+{
+	union pact_distances d = { .val = READ_ONCE(prefetch_distances.val) };
+
+	return is_tiered_promotion_dir(src_id, dst_id) ? d.promote : d.demote;
+}
