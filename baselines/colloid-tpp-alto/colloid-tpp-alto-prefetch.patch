 void folio_migrate_copy(struct folio *newfolio, struct folio *folio)
 {
+	if (static_branch_likely(&prefetch_enabled_key)) {
+		unsigned int dist = get_migration_prefetch_distance_dir(
+			folio_nid(folio), folio_nid(newfolio));
+
+		if (dist > 0) {
+			if (static_branch_unlikely(&prefetch_naive_key))
+				folio_copy_naive(newfolio, folio, dist);
+			else
+				folio_copy_adaptive(newfolio, folio, dist);
+			goto out_flags;
+		}
+	}
 	folio_copy(newfolio, folio);
+out_flags:
 	folio_migrate_flags(newfolio, folio);
 }
