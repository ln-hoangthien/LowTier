+static ssize_t prefetch_enabled_store(struct kobject *kobj,
+				      struct kobj_attribute *attr,
+				      const char *buf, size_t count)
+{
+	unsigned int val;
+	if (kstrtouint(buf, 10, &val))
+		return -EINVAL;
+	val = !!val;
+	mutex_lock(&prefetch_cfg_lock);
+	if (val != prefetch_enabled) {
+		if (val)
+			static_branch_enable(&prefetch_enabled_key);
+		else
+			static_branch_disable(&prefetch_enabled_key);
+		prefetch_enabled = val;
