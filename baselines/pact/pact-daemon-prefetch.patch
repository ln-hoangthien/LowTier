diff --git a/baselines/pact/src/prefetch-coro.c b/baselines/pact/src/prefetch-coro.c
new file mode 100644
index 0000000..765dc30
--- /dev/null
+++ b/baselines/pact/src/prefetch-coro.c
@@ -0,0 +1,187 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include "prefetch-coro.h"
+#include "pact.h"
+#include "tsc.h"
+#include "logging.h"
+
+/* Directly tie to the unified mig_telemetry and cha_mon subsystems */
+#include "../../tier-prefetch-mon/mig_cha_mon.c"
+#include "../../tier-prefetch-mon/mig_telemetry.c"
+
+#define THP_TAG_TABLE_BITS 16U
+#define THP_TAG_TABLE_SIZE (1U << THP_TAG_TABLE_BITS)
+#define THP_TAG_TABLE_MASK (THP_TAG_TABLE_SIZE - 1U)
+
+static uint64_t s_thp_fast_tags[THP_TAG_TABLE_SIZE];
+static uint64_t s_last_demoted_baseline = 0;
+static uint64_t s_demoted_4kb_credit = 0;
+static uint16_t s_demotion_epoch = 1;
+
+/*
+ * Per-thread 4KB base-page accounting for PACT's migration thread:
+ * - Called directly from mig_dispatch_batch() on the migration thread before
+ *   process_migration_batch_results() mutates metas[i]->tier.
+ * - Under THP=always, the first 4KB subpage in a 2MB frame (page_addr >> 21)
+ *   migrates the entire 2MB compound folio (512 x 4KB base pages), while
+ *   subsequent 4KB subpages in that same 2MB frame return status[i]==0 as
+ *   0-byte no-ops because the 2MB folio is already on Node 0.
+ * - Under both 4KB and 2MB modes, re-promotions (demoted_by_other) are gated
+ *   against actual kernel LRU demotion credit (stats.demotion_successes) so
+ *   stale PEBS samples on already-promoted pages do not inflate page counts.
+ */
+void prefetch_account_batch(pact_context_t *ctx, pac_metadata_t **metas, const int *status,
+                            int count)
+{
+    if (!ctx || !ctx->workload || !metas || !status || count <= 0) {
+        return;
+    }
+
+    if (!s_cfg_initialized) {
+        mig_telemetry_init_sysfs(&s_cfg);
+    }
+
+    uint64_t cur_demoted = ctx->workload->stats.demotion_successes;
+    if (cur_demoted > s_last_demoted_baseline) {
+        s_demoted_4kb_credit += (cur_demoted - s_last_demoted_baseline);
+        s_last_demoted_baseline = cur_demoted;
+        s_demotion_epoch = (uint16_t)((s_demotion_epoch + 1U) & 0x7FFFU);
+        if (s_demotion_epoch == 0) {
+            s_demotion_epoch = 1;
+        }
+    }
+
+    uint64_t added_4kb_pages = 0;
+    bool thp_mode = s_cfg.thp_always;
+
+    for (int i = 0; i < count; i++) {
+        pac_metadata_t *meta = metas[i];
+        if (!meta || status[i] != 0 || meta->tier == 0) {
+            continue;
+        }
+
+        if (thp_mode) {
+            uint64_t thp_vpn = (meta->page_addr >> 21) & 0x0000FFFFFFFFFFFFULL;
+            uint64_t valid_vpn = (1ULL << 63) | thp_vpn;
+            uint64_t tagged_entry = valid_vpn | ((uint64_t)s_demotion_epoch << 48);
+            size_t slot = (size_t)(thp_vpn & THP_TAG_TABLE_MASK);
+
+            if ((s_thp_fast_tags[slot] & 0x8000FFFFFFFFFFFFULL) != valid_vpn) {
+                s_thp_fast_tags[slot] = tagged_entry;
+                added_4kb_pages += 512ULL;
+            } else if ((s_thp_fast_tags[slot] != tagged_entry) && meta->demoted_by_other &&
+                       s_demoted_4kb_credit >= 512ULL) {
+                s_thp_fast_tags[slot] = tagged_entry;
+                s_demoted_4kb_credit -= 512ULL;
+                added_4kb_pages += 512ULL;
+            }
+        } else {
+            if (!meta->demoted_by_other) {
+                added_4kb_pages += 1ULL;
+            } else if (s_demoted_4kb_credit > 0) {
+                s_demoted_4kb_credit -= 1ULL;
+                added_4kb_pages += 1ULL;
+            }
+        }
+    }
+
+    if (added_4kb_pages > 0) {
+        __atomic_fetch_add(&ctx->migrated_4kb_pages, added_4kb_pages, __ATOMIC_RELAXED);
+    }
+}
+
+typedef enum {
+    PREFETCH_STATE_START_CAPTURE,
+    PREFETCH_STATE_FINISH_CAPTURE
+} prefetch_state_t;
+
+/*
+ * Prefetch Coroutine:
+ * Dynamic kernel prefetch distance tuner. Directly taps PACT's existing uncore
+ * CHA TOR_OCCUPANCY and core LLC misses for Little's Law latency calculation,
+ * setting telem.latencies with ZERO new PMU events.
+ *
+ * Implements a 2-stage non-blocking coroutine yield:
+ * - START_CAPTURE: Disables PACT CHAs, starts telemetry CHA capture, schedules
+ *   coroutine resume in 15 ms via next_tsc, and yields to the PACT event loop.
+ * - FINISH_CAPTURE: Wakes up after 15 ms without blocking the event loop (PEBS
+ *   aggregator runs uninterrupted), stops CHA capture, re-enables PACT CHAs,
+ *   computes telemetry step, and yields until the next stats interval.
+ */
+void prefetch_coroutine(mco_coro *co)
+{
+    pact_context_t *ctx = (pact_context_t *)mco_get_user_data(co);
+    struct mig_telemetry telem;
+    bool initialized = false;
+    prefetch_state_t state = PREFETCH_STATE_START_CAPTURE;
+    int target_uncore_cpu = (ctx && ctx->monitor_cpu >= 0) ? ctx->monitor_cpu : 0;
+
+    while (mco_status(co) != MCO_DEAD) {
+        if (!initialized) {
+            pid_t mig_tid = (ctx && ctx->migration_tid > 0) ? ctx->migration_tid : 0;
+            uint64_t cpu_mask = (ctx && ctx->workload) ? ctx->workload->cpu_mask : 0;
+            if (mig_telemetry_init(&telem, mig_tid, cpu_mask, target_uncore_cpu) == 0) {
+                initialized = true;
+                if (telem.cha_mon_enabled) {
+                    mig_cha_mon_stop(&telem.cha_mon);
+                }
+                mig_log_info(
+                    "prefetch_coro",
+                    "Prefetch telemetry initialized (cha_mon_interleaved=%d, host CPU: %d, "
+                    "mig_tid: %d)",
+                    telem.cha_mon_enabled, target_uncore_cpu, (int)mig_tid);
+            }
+        }
+
+        if (initialized) {
+            if (telem.fd_uops < 0 && ctx && ctx->migration_tid > 0) {
+                mig_telemetry_attach_tid(&telem, ctx->migration_tid);
+            }
+
+            /* Non-blocking interleaved CHA PMU capture across coroutine yields */
+            if (telem.cha_mon_enabled) {
+                if (state == PREFETCH_STATE_START_CAPTURE) {
+                    /* Step 1: Pause PACT's CHAs and start telemetry CHA window */
+                    if (ctx && ctx->workload && ctx->workload->nr_cha > 0) {
+                        ioctl_pmu_cha_perf_events(ctx->workload->cha_pmus, ctx->workload->nr_cha,
+                                                  PERF_EVENT_IOC_DISABLE);
+                    }
+                    mig_cha_mon_start(&telem.cha_mon);
+
+                    /* Schedule this coroutine to resume non-blockingly in 15 ms */
+                    if (ctx) {
+                        ctx->timing[CORO_TYPE_PREFETCH].next_tsc =
+                            rdtsc() + ms_to_tsc(ctx, 15);
+                    }
+                    state = PREFETCH_STATE_FINISH_CAPTURE;
+
+                    /* Yield back to event loop immediately; PEBS aggregator stays active */
+                    mco_yield(co);
+                    continue;
+                } else {
+                    /* Step 2: 15 ms non-blocking window elapsed; stop and resume PACT CHAs */
+                    mig_cha_mon_stop(&telem.cha_mon);
+                    if (ctx && ctx->workload && ctx->workload->nr_cha > 0) {
+                        ioctl_pmu_cha_perf_events(ctx->workload->cha_pmus, ctx->workload->nr_cha,
+                                                  PERF_EVENT_IOC_ENABLE);
+                    }
+                    state = PREFETCH_STATE_START_CAPTURE;
+                }
+            }
+
+            uint64_t pages_promoted =
+                ctx ? __atomic_load_n(&ctx->migrated_4kb_pages, __ATOMIC_RELAXED) : 0;
+
+            /* mig_telemetry_step calculates distance and logs telemetry */
+            mig_telemetry_step(&telem, pages_promoted);
+        }
+
+        mco_yield(co);
+    }
+
+    if (initialized) {
+        mig_telemetry_close(&telem);
+    }
+}
