+static inline bool is_tiered_promotion(int source_id)
+{
+	if (source_id < 0)
+		return false;
+	if (!node_is_toptier(source_id))
+		return true;
+	if (num_node_state(N_MEMORY) == num_node_state(N_CPU) && source_id > 0)
+		return true;
+	return false;
+}
+
+static inline bool is_tiered_promotion_dir(int src_id, int dst_id)
+{
+	if (src_id < 0 || dst_id < 0 || src_id == dst_id)
+		return false;
+	if (!node_is_toptier(src_id) && node_is_toptier(dst_id))
+		return true;
+	if (node_is_toptier(src_id) && !node_is_toptier(dst_id))
+		return false;
+	return src_id > dst_id;
+}
+
+static inline unsigned int get_migration_prefetch_distance(int source_id)
+{
+	union pact_distances d = { .val = READ_ONCE(prefetch_distances.val) };
+
+	return is_tiered_promotion(source_id) ? d.promote : d.demote;
+}
+
+static inline unsigned int get_migration_prefetch_distance_dir(int src_id,
+							       int dst_id)
+{
+	union pact_distances d = { .val = READ_ONCE(prefetch_distances.val) };
+
+	return is_tiered_promotion_dir(src_id, dst_id) ? d.promote : d.demote;
+}
