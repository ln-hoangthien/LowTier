+		unsigned int dist = get_migration_prefetch_distance_dir(
+			page_to_nid(page), page_to_nid(newpage));
+
+		if (dist > 0) {
+			if (static_branch_unlikely(&prefetch_naive_key))
+				copy_page_naive(newpage, page, dist);
+			else
+				copy_page_adaptive(newpage, page, dist);
+			goto out_states;
+		}
+	}
+
 	if (PageHuge(page) || PageTransHuge(page))
 		copy_huge_page(newpage, page);
 	else
 		copy_highpage(newpage, page);
 
+out_states:
 	migrate_page_states(newpage, page);
 }
