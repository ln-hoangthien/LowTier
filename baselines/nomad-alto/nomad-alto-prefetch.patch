+static ssize_t prefetch_hint_store(struct kobject *kobj,
+				   struct kobj_attribute *attr,
+				   const char *buf, size_t count)
+{
+	unsigned int val, old_val;
+	if (kstrtouint(buf, 10, &val))
+		return -EINVAL;
+	if (val > 3)
+		return -EINVAL;
+	mutex_lock(&prefetch_cfg_lock);
+	old_val = prefetch_hint;
+	if (val != old_val) {
+		/* Enable new key before disabling old key to avoid transient fallback */
+		if (val == 0)
+			static_branch_enable(&prefetch_hint_nta);
+		else if (val == 1)
+			static_branch_enable(&prefetch_hint_l3);
+		else if (val == 2)
+			static_branch_enable(&prefetch_hint_l2);
+
+		if (old_val == 0)
+			static_branch_disable(&prefetch_hint_nta);
+		else if (old_val == 1)
+			static_branch_disable(&prefetch_hint_l3);
+		else if (old_val == 2)
+			static_branch_disable(&prefetch_hint_l2);
+
+		prefetch_hint = val;
+	}
+	mutex_unlock(&prefetch_cfg_lock);
+	return count;
+}
