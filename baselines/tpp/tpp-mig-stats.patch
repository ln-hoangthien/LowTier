@@ -296,9 +298,25 @@ void remove_migration_ptes(struct page *old, struct page *new, bool locked)
  * get to the page and wait until migration is finished.
  * When we return from this function the fault will be retried.
  */
+static inline void mig_record_wait(u64 start_ns, bool is_huge)
+{
+	unsigned long wait_us =
+		(unsigned long)div_u64(ktime_get_ns() - start_ns + 500, 1000);
+
+	if (is_huge) {
+		count_vm_event(MIG_WAIT_HUGE_COUNT);
+		count_vm_events(MIG_WAIT_HUGE_US, wait_us);
+	} else {
+		count_vm_event(MIG_WAIT_COUNT);
+		count_vm_events(MIG_WAIT_US, wait_us);
+	}
+}
