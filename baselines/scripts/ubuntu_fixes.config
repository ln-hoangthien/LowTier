# ------------------------------------------------------------------------------
# Ubuntu 26.04 Boot Fixes & Safety Nets
# ------------------------------------------------------------------------------

# 0.. Disable NX_COMPAT so GRUB boots Linux 6.3 with 32-byte PE SectionAlignment
# CONFIG_EFI_DXE_MEM_ATTRIBUTES is not set


# 1. Disable module signing to prevent module_sig_check page fault crashes
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
CONFIG_LSM="landlock,yama,integrity,apparmor"
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set

# 2. Build storage drivers directly into kernel so /dev/sda and NVMe are detected at 0.00s
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# 3. Build Network (SSH) drivers directly into the kernel.
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y

# (Optional) USB/Keyboard drivers. Commented out since you only need SSH.
# They will still build as modules and load normally if systemd works.
# CONFIG_HID=y
# CONFIG_USB_XHCI_HCD=y
# CONFIG_USB_XHCI_PCI=y
# CONFIG_USB_EHCI_HCD=y
# CONFIG_USB_EHCI_PCI=y
# CONFIG_USB_HID=y
# CONFIG_HID_GENERIC=y

# 4. Enable BTF debug info. Newer Ubuntu (systemd-udevd) requires eBPF/BTF to initialize devices
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
