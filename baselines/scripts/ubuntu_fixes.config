# ------------------------------------------------------------------------------
# Ubuntu 26.04 Boot Overrides for Kernel 6+ (Colloid-TPP)
# ------------------------------------------------------------------------------

# 0. Disable NX_COMPAT for GRUB compatibility with PE SectionAlignment
# CONFIG_EFI_DXE_MEM_ATTRIBUTES is not set

# 1. Disable module signing and lockdown to allow custom/unsigned modules
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
CONFIG_LSM="landlock,yama,integrity,apparmor"
# CONFIG_MODULE_SIG is not set

# 2. Disable module compression (raw .ko ELF for finit_module compatibility)
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_COMPRESS_ZSTD is not set

# 3. Built-in Core Storage Drivers (converts =m to =y)
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VMD=y

# 4. Built-in NLS Charsets for early /boot/efi VFAT mounting (converts =m to =y)
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# 5. Built-in Autofs for early systemd initialization (converts =m to =y)
CONFIG_AUTOFS_FS=y

# 6. Built-in NIC Drivers for early networking (converts =m to =y)
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
