+/*
+ * Pipelined Cacheline Prefetching (Method 1: Cacheline-lookahead)
+ * Uses separate lookahead distances for promotion and demotion.
+ * Supports dynamic Little's Law adaptation:
+ *   adaptive=0: Static prefetch distance (promote_distance, demote_distance)
+ *   adaptive=1: Dynamic Little's Law adaptation:
+ *               Distance = TOR_OCCUPANCY / sum_cycles (MLP),
+ *               dynamically updated via promote_distance and demote_distance
+ *
+ * Promotion (remote slow tier -> local fast tier):
+ *   Uses promote_distance (def: 5)
+ * Demotion (local fast tier -> remote slow tier):
+ *   Uses demote_distance (def: 2)
+ *
+ * Configurable via sysfs (/sys/kernel/mm/page_prefetch/):
+ *   enabled:                  master toggle (0 or 1, default: 1)
+ *   adaptive:                 adaptation mode (0=static, 1=adaptive Little's Law, default: 1)
+ *   promote_distance:         lookahead distance for promotion (default: 5)
+ *   demote_distance:          lookahead distance for demotion (default: 2)
+ *   min_distance:             minimum clamp distance (default: 1)
+ *   max_distance:             maximum clamp distance (default: 16)
+ *   hint:                     cache hint (0=NTA, 1=L3, 2=L2, 3=L1)
+ */
+#define PREFETCH_DEFAULT_PROMOTE_DISTANCE      5
+#define PREFETCH_DEFAULT_DEMOTE_DISTANCE       2
+#define PREFETCH_DEFAULT_MIN_DISTANCE          1
+#define PREFETCH_DEFAULT_MAX_DISTANCE          16
+#define PREFETCH_DEFAULT_HINT                  0
+
+static unsigned int prefetch_enabled = 1;
+static unsigned int prefetch_adaptive = 1;
+static unsigned int prefetch_promote_distance = PREFETCH_DEFAULT_PROMOTE_DISTANCE;
+static unsigned int prefetch_demote_distance = PREFETCH_DEFAULT_DEMOTE_DISTANCE;
+static unsigned int prefetch_min_distance = PREFETCH_DEFAULT_MIN_DISTANCE;
+static unsigned int prefetch_max_distance = PREFETCH_DEFAULT_MAX_DISTANCE;
+static unsigned int prefetch_hint = PREFETCH_DEFAULT_HINT;
+
+#include <asm/msr.h>
+#include <linux/atomic.h>
+
+#define PREFETCH_DEFAULT_HIT_THRESH_CYC   30   /* <= 30 cycles: L1/L2 cache hit */
+#define PREFETCH_DEFAULT_LATE_THRESH_CYC  150  /* 31-150 cycles: in-flight LFB wait */
+
+/* Per-CPU stats for latency sampling */
+struct page_prefetch_cpu_stats {
+	u64 total_samples;
+	u64 timely_hits;
+	u64 late_pf;
+	u64 soon_or_miss;
+	u64 total_cycles;
+};
+
+static DEFINE_PER_CPU(struct page_prefetch_cpu_stats, pf_cpu_stats);
+
+static unsigned int pf_stats_enabled = 1;
+static unsigned int pf_hit_threshold_cycles = PREFETCH_DEFAULT_HIT_THRESH_CYC;
+static unsigned int pf_late_threshold_cycles = PREFETCH_DEFAULT_LATE_THRESH_CYC;
+
+void page_prefetch_set_tier_distances(unsigned int local_dist, unsigned int remote_dist)
+{
+	if (local_dist)
+		WRITE_ONCE(prefetch_demote_distance, local_dist);
+	if (remote_dist)
+		WRITE_ONCE(prefetch_promote_distance, remote_dist);
+}
+EXPORT_SYMBOL(page_prefetch_set_tier_distances);
+
+static inline void prefetch_cacheline(const void *addr, unsigned int hint)
+{
+	switch (hint) {
+	case 0:
+		__builtin_prefetch(addr, 0 /* read */, 0 /* NTA */);
+		break;
+	case 1:
+		__builtin_prefetch(addr, 0, 1 /* L3 */);
+		break;
+	case 2:
+		__builtin_prefetch(addr, 0, 2 /* L2 */);
+		break;
+	case 3:
+	default:
+		__builtin_prefetch(addr, 0, 3 /* L1/L2/L3 */);
+		break;
+	}
+}
+
+/*
+ * Decoupled Latency-Adaptive ERMS Engine:
+ * 1. Primes initial D lines of current source (strictly bounded to LFB budget)
+ * 2. Samples timeliness on line 0 via rdtsc_ordered()
+ * 3. Bulk transfer via native hardware ERMS copy_page()
+ */
+static void copy_page_adaptive(void *dst, const void *src,
+				    unsigned int distance,
+				    unsigned int hint)
+{
+	unsigned int dist_lines = distance ? clamp(distance, 1U, 8U) : 0;
+	unsigned int i;
+
+	/*
+	 * 1. Prime ONLY the current source window.
+	 *    Issuing dist_lines (<= 8) keeps outstanding fills
+	 *    strictly within the core's Line Fill Buffer (LFB) budget.
+	 */
+	for (i = 0; i < dist_lines; i++)
+		prefetch_cacheline((const char *)src + (i * SMP_CACHE_BYTES), hint);
+
+	/*
+	 * 2. PROBE TIMELINESS SAMPLING:
+	 * Subsample 1 out of every 64 pages (0x3F mask) to eliminate
+	 * RDTSC/LFENCE serialization overhead while retaining statistical accuracy.
+	 */
+	if (READ_ONCE(pf_stats_enabled) && dist_lines > 0) {
+		static DEFINE_PER_CPU(unsigned int, pf_sample_idx);
+
+		if ((this_cpu_inc_return(pf_sample_idx) & 0x3F) == 0) {
+			const volatile u64 *probe = (const volatile u64 *)src;
+			u64 t0, t1, lat;
+
+			t0 = rdtsc_ordered();
+			(void)*probe;
+			t1 = rdtsc_ordered();
+
+			lat = (t1 > t0) ? (t1 - t0) : 0;
+
+			/* Lockless per-CPU tracking */
+			this_cpu_inc(pf_cpu_stats.total_samples);
+			this_cpu_add(pf_cpu_stats.total_cycles, lat);
+
+			if (lat <= READ_ONCE(pf_hit_threshold_cycles))
+				this_cpu_inc(pf_cpu_stats.timely_hits);
+			else if (lat <= READ_ONCE(pf_late_threshold_cycles))
+				this_cpu_inc(pf_cpu_stats.late_pf);
+			else
+				this_cpu_inc(pf_cpu_stats.soon_or_miss);
+		}
+	}
+
+	/* 3. Bulk transfer via native hardware ERMS (rep movsb) */
+	copy_page(dst, (void *)src);
+}
+
+/*
+ * Decoupled Latency-Adaptive ERMS Folio Copy:
+ */
+static void folio_copy_adaptive(struct folio *dst, struct folio *src,
+				     unsigned int distance)
+{
+	long nr = folio_nr_pages(src);
+	long i;
+
+	if (distance == 0) {
+		folio_copy(dst, src);
+		return;
+	}
+
+	for (i = 0; i < nr; i++) {
+		struct page *src_p = folio_page(src, i);
+		struct page *dst_p = folio_page(dst, i);
+
+		char *dst_k = kmap_local_page(dst_p);
+		const char *src_k = kmap_local_page(src_p);
+
+		/* Prime D lines of src and copy via ERMS */
+		copy_page_adaptive(dst_k, src_k, distance, prefetch_hint);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+
+		if ((i & 0x1F) == 0x1F && (i + 1 < nr))
+			cond_resched();
+	}
+}
+
+static inline bool is_tiered_promotion(int source_id)
+{
+	if (source_id < 0)
+		return false;
+	if (!node_is_toptier(source_id) || source_id > 0)
+		return true;
+	return false;
+}
+
+static inline unsigned int get_migration_prefetch_distance(int source_id)
+{
+	unsigned int dist;
+	unsigned int min_dist, max_dist;
+
+	if (!READ_ONCE(prefetch_adaptive)) {
+		return is_tiered_promotion(source_id) ?
+			PREFETCH_DEFAULT_PROMOTE_DISTANCE :
+			PREFETCH_DEFAULT_DEMOTE_DISTANCE;
+	}
+
+	if (is_tiered_promotion(source_id))
+		dist = READ_ONCE(prefetch_promote_distance);
+	else
+		dist = READ_ONCE(prefetch_demote_distance);
+
+	min_dist = READ_ONCE(prefetch_min_distance);
+	max_dist = READ_ONCE(prefetch_max_distance);
+
+	if (min_dist > max_dist)
+		min_dist = max_dist;
+
+	return clamp(dist, min_dist, max_dist);
+}
