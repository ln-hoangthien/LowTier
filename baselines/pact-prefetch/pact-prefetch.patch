+static int __init prefetch_sysfs_init(void)
+{
+	struct kobject *kobj;
+	int err;
+
+	kobj = kobject_create_and_add("page_prefetch", mm_kobj);
+	if (!kobj)
+		return -ENOMEM;
+
+	err = sysfs_create_group(kobj, &prefetch_attr_group);
+	if (err) {
+		kobject_put(kobj);
+		return err;
+	}
+	if (sysfs_create_link_nowarn(mm_kobj, kobj, "pact_prefetch")) {
+		/* Non-fatal: legacy compatibility alias */
+	}
+	return 0;
+}
+subsys_initcall(prefetch_sysfs_init);
