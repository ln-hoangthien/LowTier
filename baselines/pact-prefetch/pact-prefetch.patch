+/*
+ * Pipelined Cacheline Prefetching (Method 1: Cacheline-lookahead)
+ * Uses separate lookahead distances for promotion and demotion.
+ * Supports dynamic Little's Law adaptation:
+ *   adaptive=0: Static prefetch distance (promote_distance, demote_distance)
+ *   adaptive=1: Dynamic Little's Law adaptation:
+ *               Distance = TOR_OCCUPANCY / sum_cycles (MLP),
+ *               dynamically updated via promote_distance and demote_distance
+ *
+ * Promotion (remote slow tier -> local fast tier):
+ *   Uses promote_distance (def: 5)
+ * Demotion (local fast tier -> remote slow tier):
+ *   Uses demote_distance (def: 2)
+ *
+ * Configurable via sysfs (/sys/kernel/mm/page_prefetch/):
+ *   enabled:                  master toggle (0 or 1, default: 1)
+ *   adaptive:                 adaptation mode (0=static, 1=adaptive Little's Law, default: 1)
+ *   promote_distance:         lookahead distance for promotion (default: 5)
+ *   demote_distance:          lookahead distance for demotion (default: 2)
+ *   min_distance:             minimum clamp distance (default: 1)
+ *   max_distance:             maximum clamp distance (default: 16)
+ *   hint:                     cache hint (0=NTA, 1=L3, 2=L2, 3=L1, default: 0)
+ */
+#define PREFETCH_DEFAULT_PROMOTE_DISTANCE      5
+#define PREFETCH_DEFAULT_DEMOTE_DISTANCE       2
+#define PREFETCH_DEFAULT_MIN_DISTANCE          1
+#define PREFETCH_DEFAULT_MAX_DISTANCE          16
+#define PREFETCH_DEFAULT_HINT                  0
+
+static unsigned int prefetch_enabled = 1;
+static unsigned int prefetch_adaptive = 1;
+static unsigned int prefetch_promote_distance = PREFETCH_DEFAULT_PROMOTE_DISTANCE;
+static unsigned int prefetch_demote_distance = PREFETCH_DEFAULT_DEMOTE_DISTANCE;
+static unsigned int prefetch_min_distance = PREFETCH_DEFAULT_MIN_DISTANCE;
+static unsigned int prefetch_max_distance = PREFETCH_DEFAULT_MAX_DISTANCE;
+static unsigned int prefetch_hint = PREFETCH_DEFAULT_HINT;
+
+void page_prefetch_set_tier_distances(unsigned int local_dist, unsigned int remote_dist)
+{
+	if (local_dist)
+		WRITE_ONCE(prefetch_demote_distance, local_dist);
+	if (remote_dist)
+		WRITE_ONCE(prefetch_promote_distance, remote_dist);
+}
+EXPORT_SYMBOL(page_prefetch_set_tier_distances);
+
+static inline bool is_tiered_promotion(int source_id)
+{
+	if (source_id < 0)
+		return false;
+	if (!node_is_toptier(source_id) || source_id > 0)
+		return true;
+	return false;
+}
+
+static inline unsigned int get_migration_prefetch_distance(int source_id)
+{
+	return is_tiered_promotion(source_id) ?
+		READ_ONCE(prefetch_promote_distance) :
+		READ_ONCE(prefetch_demote_distance);
+}
+
+static inline void prefetch_cacheline(const void *addr, unsigned int hint)
+{
+	switch (hint) {
+	case 0:
+		__builtin_prefetch(addr, 0 /* read */, 0 /* NTA */);
+		break;
+	case 1:
+		__builtin_prefetch(addr, 0, 1 /* L3 */);
+		break;
+	case 2:
+		__builtin_prefetch(addr, 0, 2 /* L2 */);
+		break;
+	case 3:
+	default:
+		__builtin_prefetch(addr, 0, 3 /* L1/L2/L3 */);
+		break;
+	}
+}
+
+static inline void prefetch_page_head(struct page *page, unsigned int dist,
+				      unsigned int hint)
+{
+	const char *addr;
+	unsigned int i, d;
+
+	if (!dist || PageHighMem(page))
+		return;
+
+	d = clamp(dist, READ_ONCE(prefetch_min_distance),
+		  min(READ_ONCE(prefetch_max_distance), 16U));
+	addr = page_address(page);
+	for (i = 0; i < d; i++)
+		prefetch_cacheline(addr + (i * SMP_CACHE_BYTES), hint);
+}
+
+static inline void prefetch_folio_head(struct folio *folio)
+{
+	if (!READ_ONCE(prefetch_enabled))
+		return;
+	prefetch_page_head(folio_page(folio, 0),
+			   get_migration_prefetch_distance(folio_nid(folio)),
+			   READ_ONCE(prefetch_hint));
+}
+
+/*
+ * Decoupled Latency-Adaptive ERMS Folio Copy:
+ */
+static void folio_copy_adaptive(struct folio *dst, struct folio *src,
+				unsigned int distance)
+{
+	long nr = folio_nr_pages(src);
+	long i;
+
+	if (!distance || nr <= 1) {
+		folio_copy(dst, src);
+		return;
+	}
+
+	for (i = 0; i < nr; i++) {
+		struct page *src_p = folio_page(src, i);
+		struct page *dst_p = folio_page(dst, i);
+
+		char *dst_k = kmap_local_page(dst_p);
+		const char *src_k = kmap_local_page(src_p);
+
+		if (i + 1 < nr)
+			prefetch_page_head(folio_page(src, i + 1), distance, READ_ONCE(prefetch_hint));
+		copy_page(dst_k, (void *)src_k);
+
+		kunmap_local(src_k);
+		kunmap_local(dst_k);
+
+		if ((i & 0x1F) == 0x1F && (i + 1 < nr))
+			cond_resched();
+	}
+}
