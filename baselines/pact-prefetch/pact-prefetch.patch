+
 void folio_migrate_copy(struct folio *newfolio, struct folio *folio)
 {
-	folio_copy(newfolio, folio);
+	if (READ_ONCE(prefetch_enabled)) {
+		int source_id = folio_nid(folio);
+		int dst_nid = folio_nid(newfolio);
+		unsigned int dist = get_migration_prefetch_distance(source_id);
+
+		/* Fast lockless check: only log when distance or direction changes on this CPU */
+		static DEFINE_PER_CPU(unsigned int, last_dist);
+		static DEFINE_PER_CPU(int, last_src);
+
+		if (unlikely(dist != this_cpu_read(last_dist) || source_id != this_cpu_read(last_src))) {
+			const char *type = (source_id == dst_nid) ? "SAME-TIER" :
+					   (is_tiered_promotion(source_id) ? "PROMOTION" : "DEMOTION");
+
+			this_cpu_write(last_dist, dist);
+			this_cpu_write(last_src, source_id);
+
+			pr_info("folio_migrate_copy [%s]: dist=%u (nid %d -> %d)\n",
+				type, dist, source_id, dst_nid);
+		}
+
+		if (dist > 0)
+			folio_copy_adaptive(newfolio, folio, dist);
+		else
+			folio_copy(newfolio, folio);
+
+	} else {
+		folio_copy(newfolio, folio);
+	}
 	folio_migrate_flags(newfolio, folio);
 }
 EXPORT_SYMBOL(folio_migrate_copy);
