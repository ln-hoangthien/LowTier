+static ssize_t prefetch_stats_show(struct kobject *kobj,
+				   struct kobj_attribute *attr, char *buf)
+{
+	u64 total = 0, hits = 0, late = 0, miss = 0, cyc = 0;
+	int cpu;
+
+	for_each_online_cpu(cpu) {
+		struct page_prefetch_cpu_stats *s = &per_cpu(pf_cpu_stats, cpu);
+		total += READ_ONCE(s->total_samples);
+		hits  += READ_ONCE(s->timely_hits);
+		late  += READ_ONCE(s->late_pf);
+		miss  += READ_ONCE(s->soon_or_miss);
+		cyc   += READ_ONCE(s->total_cycles);
+	}
+
+	return sprintf(buf,
+		       "total_samples:     %llu\n"
+		       "timely_hits:       %llu (%llu.%02llu%%)\n"
+		       "late_prefetches:   %llu (%llu.%02llu%%)\n"
+		       "soon_or_misses:    %llu (%llu.%02llu%%)\n"
+		       "avg_probe_cycles:  %llu.%02llu\n"
+		       "hit_thresh_cyc:    %u\n"
+		       "late_thresh_cyc:   %u\n",
+		       total,
+		       hits, total ? (hits * 100) / total : 0, total ? ((hits * 10000) / total) % 100 : 0,
+		       late, total ? (late * 100) / total : 0, total ? ((late * 10000) / total) % 100 : 0,
+		       miss, total ? (miss * 100) / total : 0, total ? ((miss * 10000) / total) % 100 : 0,
+		       total ? cyc / total : 0, total ? ((cyc * 100) / total) % 100 : 0,
+		       READ_ONCE(pf_hit_threshold_cycles),
+		       READ_ONCE(pf_late_threshold_cycles));
+}
+static struct kobj_attribute prefetch_stats_attr =
+	__ATTR(stats, 0444, prefetch_stats_show, NULL);
+
+static ssize_t prefetch_stats_reset_store(struct kobject *kobj,
+					  struct kobj_attribute *attr,
+					  const char *buf, size_t count)
+{
+	int cpu;
+	for_each_possible_cpu(cpu) {
+		struct page_prefetch_cpu_stats *s = &per_cpu(pf_cpu_stats, cpu);
+		WRITE_ONCE(s->total_samples, 0);
+		WRITE_ONCE(s->timely_hits, 0);
+		WRITE_ONCE(s->late_pf, 0);
+		WRITE_ONCE(s->soon_or_miss, 0);
+		WRITE_ONCE(s->total_cycles, 0);
+	}
+	return count;
+}
+static struct kobj_attribute prefetch_stats_reset_attr =
+	__ATTR(stats_reset, 0200, NULL, prefetch_stats_reset_store);
+
+static struct attribute *prefetch_attrs[] = {
+	&prefetch_enabled_attr.attr,
+	&prefetch_adaptive_attr.attr,
+	&prefetch_promote_distance_attr.attr,
+	&prefetch_demote_distance_attr.attr,
+	&prefetch_min_distance_attr.attr,
+	&prefetch_max_distance_attr.attr,
+	&prefetch_hint_attr.attr,
+	&prefetch_stats_attr.attr,
+	&prefetch_stats_reset_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group prefetch_attr_group = {
+	.attrs = prefetch_attrs,
+};
+
+static int __init prefetch_sysfs_init(void)
+{
+	struct kobject *kobj;
+	int err;
+
+	kobj = kobject_create_and_add("page_prefetch", mm_kobj);
+	if (!kobj)
+		return -ENOMEM;
+
+	err = sysfs_create_group(kobj, &prefetch_attr_group);
+	if (err) {
+		kobject_put(kobj);
+		return err;
+	}
+	if (sysfs_create_link_nowarn(mm_kobj, kobj, "pact_prefetch")) {
+		/* Non-fatal: legacy compatibility alias */
+	}
+	return 0;
+}
+subsys_initcall(prefetch_sysfs_init);
