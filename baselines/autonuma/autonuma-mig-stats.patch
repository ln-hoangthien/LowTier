 	softleaf_t entry;
 	pte_t pte;
@@ -547,7 +566,8 @@ void migration_entry_wait_huge(struct vm_area_struct *vma, unsigned long addr, p
 		 * lock release in softleaf_entry_wait_on_locked().
 		 */
 		hugetlb_vma_unlock_read(vma);
 		softleaf_entry_wait_on_locked(entry, ptl);
+		mig_record_wait(wait_start_ns, true);
 		return;
 	}
 
@@ -560,12 +580,14 @@ fail:
 #ifdef CONFIG_ARCH_HAS_PMD_SOFTLEAVES
 void pmd_migration_entry_wait(struct mm_struct *mm, pmd_t *pmd)
 {
+	u64 wait_start_ns = ktime_get_ns();
 	spinlock_t *ptl;
 
 	ptl = pmd_lock(mm, pmd);
 	if (!pmd_is_migration_entry(*pmd))
 		goto unlock;
 	softleaf_entry_wait_on_locked(softleaf_from_pmd(*pmd), ptl);
+	mig_record_wait(wait_start_ns, true);
 	return;
 unlock:
 	spin_unlock(ptl);
@@ -2101,6 +2123,7 @@ int migrate_pages(struct list_head *from, new_folio_t get_new_folio,
 		free_folio_t put_new_folio, unsigned long private,
