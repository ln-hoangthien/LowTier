 #include <linux/export.h>
 #include <linux/swap.h>
 #include <linux/leafops.h>
@@ -490,9 +492,24 @@ void remove_migration_ptes(struct folio *src, struct folio *dst,
  * get to the page and wait until migration is finished.
  * When we return from this function the fault will be retried.
  */
+static inline void mig_record_wait(u64 start_ns, bool is_huge)
+{
+	unsigned long wait_us =
+		(unsigned long)div_u64(ktime_get_ns() - start_ns + 500, 1000);
+
+	if (is_huge) {
+		count_vm_event(MIG_WAIT_HUGE_COUNT);
+		count_vm_events(MIG_WAIT_HUGE_US, wait_us);
+	} else {
+		count_vm_event(MIG_WAIT_COUNT);
+		count_vm_events(MIG_WAIT_US, wait_us);
+	}
+}
+
 void migration_entry_wait(struct mm_struct *mm, pmd_t *pmd,
 			  unsigned long address)
 {
+	u64 wait_start_ns = ktime_get_ns();
 	spinlock_t *ptl;
 	pte_t *ptep;
 	pte_t pte;
@@ -512,7 +529,8 @@ void migration_entry_wait(struct mm_struct *mm, pmd_t *pmd,
 	if (!softleaf_is_migration(entry))
 		goto out;
 
 	softleaf_entry_wait_on_locked(entry, ptl);
+	mig_record_wait(wait_start_ns, false);
 	return;
 out:
 	spin_unlock(ptl);
@@ -527,6 +545,7 @@ out:
  */
